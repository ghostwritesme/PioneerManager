				<field name="uiMaxCarStrategyNearTarget" type="Int64"/>
				<field name="MaxDistForSpeedAdjustment" type="BinHex"/>
				<field name="MinDistForSpeedAdjustment" type="BinHex"/>
			</object>
		</object>
	</object>
	<object name="Misc">
		<field name="bCanUsePartialBlockedLane" type="Boolean"/>
		<field name="bObeyIntersections" type="Boolean"/>
		<field name="bUseShortcutLanes" type="Boolean"/>
	</object>
	<object name="Alley">
		<field name="fCooldown" type="Float"/>
	</object>
	<object name="PlayerZoneSize">
		<object name="StandardSearch">
			<field name="MaxDistForSpeedAdjustment" type="BinHex"/>
			<field name="MinDistForSpeedAdjustment" type="BinHex"/>
			<field name="fStartSize" type="Float"/>
			<field name="fStopSize" type="Float"/>
			<field name="fIncreaseSizeBySec" type="Float"/>
		</object>
		<object name="InfiniteSearch">
			<field name="fResetStrategyCycleTimer" type="Float"/>
			<field name="uiMaxCarStrategyPredicAhead" type="Int64"/>
			<field name="uiMaxCarStrategyPredictBack" type="Int64"/>
			<field name="uiMaxCarStrategyPredictCenter" type="Int64"/>
			<field name="uiMaxCarStrategyRandom" type="Int64"/>
			<field name="uiMaxCarStrategyNearTarget" type="Int64"/>
			<field name="fStartSize" type="Float"/>
			<field name="fStopSize" type="Float"/>
			<field name="fIncreaseSizeBySec" type="Float"/>
		</object>
	</object>
</class>